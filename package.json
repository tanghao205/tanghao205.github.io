{
  "name": "hao-tang-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hao Tang's personal engineering portfolio",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanghao205/tanghao205.github.io.git"
  },
  "author": "Hao Tang",
  "homepage": "https://tanghao205.github.io/",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs --watch",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "test": "playwright test",
    "test:content": "node --test tests/content-db.test.mjs",
    "test:backend": "node --test tests/message-api.test.mjs tests/network-digest.test.mjs",
    "content": "node scripts/content.mjs",
    "format": "prettier --write index.html assets/portfolio/style.css assets/portfolio/*.js supabase/functions/**/*.js scripts/*.mjs tests/*.mjs playwright.config.mjs package.json",
    "format:check": "prettier --check index.html assets/portfolio/style.css assets/portfolio/*.js supabase/functions/**/*.js scripts/*.mjs tests/*.mjs playwright.config.mjs package.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
