# Copy to private/supabase-runtime.env. Never put actual secrets in this template.
ALLOWED_ORIGINS=https://tanghao205.github.io
TURNSTILE_SECRET_KEY=
RATE_LIMIT_SECRET=
GEO_LOOKUP_ENABLED=true
# Integer 1–3650, or unlimited to disable automatic expiry. Apply with configure-messaging.ps1.
NETWORK_RETENTION_DAYS=30
VISIT_RETENTION_DAYS=90
# Generated locally. Also stored in Supabase Vault for the weekly scheduler.
DIGEST_JOB_SECRET=
# Keep false to receive only the weekly digest, rather than an email per message.
IMMEDIATE_NOTIFICATIONS=false
# Optional Resend notifications: use a verified sender and a private recipient.
RESEND_API_KEY=
NOTIFICATION_FROM=
NOTIFICATION_TO=
